{
  "name": "oncer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Performs brain tumour segmentation on structural MRI scans using a 2D U-Net",
  "scripts": {
    "start": "concurrently \"npm run start:app\" \"npm run start:api\"",
    "start:app": "cd app && vite",
    "start:api": "cd api && nodemon src/app.ts",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "keywords": [
    "vue",
    "express",
    "tensorflow",
    "tumor-detection",
    "ml",
    "medical-images",
    "brain",
    "glioma"
  ],
  "author": "Aaren Arasaratnam",
  "license": "ISC",
  "dependencies": {
    "@tensorflow/tfjs": "^4.21.0",
    "canvas": "^2.11.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "npyjs": "^0.7.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.4",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.44.1",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.16.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "jsdom": "^24.1.0",
    "nodemon": "^3.1.4",
    "sass-embedded": "^1.83.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.39.1",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.21"
  }
}
